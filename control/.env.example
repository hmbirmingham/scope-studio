# Scope Studio control plane. Hosted on Railway; holds the secrets a user's
# machine must never see. Copy to .env for local development.
# The server refuses to start on a missing required value: never put a
# placeholder or a default here.

# Required. On Railway, reference the Postgres service's private URL:
#   ${{Postgres.DATABASE_URL}}
# Locally: createdb scope_control_dev
DATABASE_URL=

# Tests only, and only against localhost (the helpers refuse anything else).
# Locally: createdb scope_control_test
TEST_DATABASE_URL=

# Railway sets PORT itself. Locally the control plane defaults to 3101 so it
# can run beside the local engine on 3001.
# PORT=3101

# ---- Accounts and sign-in -------------------------------------------------

# Required. Signs the browser session cookie for the sign-in and billing
# pages. A long random value that exists only in this service's variables,
# e.g. the output of `openssl rand -hex 32` run once by whoever sets up the
# service. Changing it signs every browser out (device tokens are unaffected).
# In CI it comes from the repository secret SESSION_SECRET.
CONTROL_SESSION_SECRET=

# Optional. Comma-separated emails allowed to sign in with dev mode, which
# gives that device the Engineer plan without a subscription. Unset means
# nobody. Taking an email off the list ends dev mode on its devices at the
# next request.
DEV_MODE_EMAILS=

# Optional. Where a notice of each dev-mode sign-in is emailed. If this or
# either value below is unset, the sign-in is still recorded in dev_logins
# and the notice is skipped with a logged warning; there is no default.
DEV_LOGIN_NOTIFY_EMAIL=

# Optional. The sender address for notices. It must be on a domain verified
# in Resend (resend.com > Domains).
NOTIFY_FROM_EMAIL=

# Optional. A Resend API key with sending access (resend.com > API Keys >
# Create API key, permission "Sending access").
RESEND_API_KEY=


# Scope Studio control plane. Hosted on Railway; holds the secrets a user's
# machine must never see. Copy to .env for local development.
# The server refuses to start on a missing required value: never put a
# placeholder or a default here.

# Required. On Railway, reference the Postgres service's private URL:
#   ${{Postgres.DATABASE_URL}}
# Locally: createdb scope_control_dev
DATABASE_URL=

# Tests only, and only against localhost (the helpers refuse anything else).
# Locally: createdb scope_control_test
TEST_DATABASE_URL=

# Railway sets PORT itself. Locally the control plane defaults to 3101 so it
# can run beside the local engine on 3001.
# PORT=3101

# ---- Accounts and sign-in -------------------------------------------------

# ---- Billing (Stripe Managed Payments) -------------------------------------
# Stripe is the merchant of record (collects and remits sales tax, VAT, GST).
# Leave all of these empty to run without billing: every billing route then
# answers 503 billing_not_configured. Set any of them and all are required;
# a missing or mismatched value turns billing off with one logged error that
# names the variable, never its value.

# Required: "test" or "live". Stated, never inferred from the key: billing
# refuses a key whose prefix does not match (sk_test_/rk_test_ for test,
# sk_live_/rk_live_ for live).
STRIPE_MODE=

# Prefer a restricted key (rk_...), least privilege: Customers write,
# Checkout Sessions write, Customer portal write, Subscriptions read.
# Create it in a Stripe sandbox while testing (Developers -> API keys).
STRIPE_SECRET_KEY=

# The whsec_ signing secret of the webhook endpoint (Developers -> Webhooks).
# Endpoint URL: <BASE_URL>/v1/billing/webhook, Snapshot payload, events:
# customer.subscription.created/updated/deleted/paused/resumed,
# invoice.paid, invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=

# Price ids (price_...) of each plan's monthly product. One variable per
# sellable plan; src/billing/stripe.js maps each plan to its variable.
STRIPE_PRICE_KEY_PRO=
STRIPE_PRICE_STUDENT=
STRIPE_PRICE_ENGINEER=

# The control plane's public URL, e.g. its Railway domain. Checkout and the
# customer portal return the browser to <BASE_URL>/billing/done.
BASE_URL=

# Tests only: points the Stripe client at a local stand-in. Accepted only on
# a loopback host in test mode.
# STRIPE_API_BASE=

# ---- Platform cloud ---------------------------------------------------------

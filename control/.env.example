# Scope Studio control plane. Hosted on Railway; holds the secrets a user's
# machine must never see. Copy to .env for local development.
# The server refuses to start on a missing required value: never put a
# placeholder or a default here.

# Required. On Railway, reference the Postgres service's private URL:
#   ${{Postgres.DATABASE_URL}}
# Locally: createdb scope_control_dev
DATABASE_URL=

# Tests only, and only against localhost (the helpers refuse anything else).
# Locally: createdb scope_control_test
TEST_DATABASE_URL=

# Railway sets PORT itself. Locally the control plane defaults to 3101 so it
# can run beside the local engine on 3001.
# PORT=3101


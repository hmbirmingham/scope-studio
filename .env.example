# Required
NODE_ENV=
DATABASE_URL=                    # Dev: local Postgres 18 + pgvector, e.g. postgresql://<user>@localhost:5432/scope_studio_dev
                                  #      (brew install postgresql@18 pgvector; brew services start postgresql@18)
                                  # Local only — there is no deployed database any more.
TEST_DATABASE_URL=               # Separate local database for `npm test`; the harness refuses non-local hosts
SESSION_SECRET=                  # Generate: openssl rand -hex 32
BASE_URL=                        # Full deployment URL, no trailing slash

# OAuth (added per plugin)
GITHUB_CLIENT_ID=                # Public client id of an OAuth App (github.com/settings/developers) with
                                  # "Enable Device Flow" ticked. Sign-in is the device flow, so there is no
                                  # client secret and no callback URL.
GITHUB_OAUTH_BASE=               # Tests only — points GitHub sign-in at a local stand-in

# Optional
OLLAMA_URL=                      # Defaults to http://localhost:11434
OLLAMA_CHAT_MODEL=               # Local tier model; defaults to qwen3:8b (ollama pull qwen3:8b)

# There is no cloud tier here and no API key. Cloud work goes through the scope
# CLI, which spends a rationed daily budget on headless Claude Code.

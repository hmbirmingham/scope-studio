# Required
NODE_ENV=
DATABASE_URL=                    # Dev: local Postgres 18 + pgvector, e.g. postgresql://<user>@localhost:5432/scope_studio_dev
                                  #      (brew install postgresql@18 pgvector; brew services start postgresql@18)
                                  # Prod: Railway Postgres. Tests must never point at production.
TEST_DATABASE_URL=               # Separate local database for `npm test`; the harness refuses non-local hosts
SESSION_SECRET=                  # Generate: openssl rand -hex 32
BASE_URL=                        # Full deployment URL, no trailing slash

# OAuth (added per plugin)
GITHUB_CLIENT_ID=                # Public client id of an OAuth App (github.com/settings/developers) with
                                  # "Enable Device Flow" ticked. Sign-in is the device flow, so there is no
                                  # client secret and no callback URL.
GITHUB_OAUTH_BASE=               # Tests only — points GitHub sign-in at a local stand-in

# Optional
OLLAMA_URL=                      # Defaults to http://localhost:11434
OLLAMA_CHAT_MODEL=               # Local tier model; defaults to qwen3:8b (ollama pull qwen3:8b)
SCOPE_DATA_DIR=                  # Absolute path for app data such as agent sandboxes; defaults to
                                  # $XDG_DATA_HOME/scope-studio or ~/.local/share/scope-studio (Linux),
                                  # ~/Library/Application Support/Scope Studio (macOS). Never inside a project
                                  # checkout. Generated code runs only under bubblewrap (Linux) or
                                  # sandbox-exec (macOS); without one it is refused.

# Cloud tier — on Key Pro the user's own Anthropic key travels per request in
# the x-anthropic-api-key header and is never stored server-side.
PLATFORM_ANTHROPIC_API_KEY=      # Optional. Pays for Auto cloud answers on Student and Engineer, only when the
                                  # local model cannot answer and only within the plan's weekly allowance.
                                  # Unset means those plans answer locally only. Create at console.anthropic.com.
CLOUD_CHAT_MODEL=                # Optional Key Pro override; only claude-sonnet-5 or claude-haiku-4-5 are offered
                                  # (platform-paid answers use Sonnet, then Haiku past half the week's allowance)
CLOUD_EFFORT=                    # Optional override; otherwise the plan decides (student medium, engineer high)
# Billing — Stripe Managed Payments, the merchant of record (collects and remits sales tax, VAT, GST).
# All five are needed; with any missing, billing reports itself unavailable. No defaults.
STRIPE_SECRET_KEY=               # Prefer a restricted key (rk_…), least privilege: Customers write,
                                  # Checkout Sessions write, Customer portal write, Subscriptions read.
                                  # Create it in a Stripe sandbox while testing (Developers → API keys).
STRIPE_WEBHOOK_SECRET=           # The whsec_ signing secret of the webhook endpoint (Developers → Webhooks)
STRIPE_PRICE_KEY_PRO=            # Price id (price_...) of the $5/month Key Pro product
STRIPE_PRICE_STUDENT=            # Price id of the $12/month Student product
STRIPE_PRICE_ENGINEER=           # Price id of the $25/month Engineer product
STRIPE_API_BASE=                 # Tests only — points the client at a local stand-in
ANTHROPIC_BASE_URL=              # Tests only — points the SDK at a local stand-in

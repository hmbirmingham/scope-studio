# Required
NODE_ENV=
DATABASE_URL=                    # Railway PostgreSQL URL (pgvector extension enabled)
SESSION_SECRET=                  # Generate: openssl rand -hex 32
BASE_URL=                        # Full deployment URL, no trailing slash

# OAuth (added per plugin)
GITHUB_CLIENT_ID=                # Create at github.com/settings/developers
GITHUB_CLIENT_SECRET=            # Same OAuth app as CLIENT_ID

# Optional — user provides their own, never stored server-side
# ANTHROPIC_API_KEY handled client-side only

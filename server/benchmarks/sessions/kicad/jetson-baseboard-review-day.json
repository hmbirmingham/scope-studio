{
  "id": "kicad-jetson-baseboard-review-day",
  "plugin": "kicad",
  "plugins": ["kicad"],
  "status": "pending",
  "description": "A hardware review day on an open carrier board: power tree, nets, footprints, differential pairs, BOM consolidation and ERC-style issues. The acceptance gate for the KiCad plug-in.",
  "fixture": {
    "kind": "reference",
    "url": "https://github.com/antmicro/jetson-nano-baseboard",
    "license": "Apache-2.0",
    "project": "antmicro/jetson-nano-baseboard",
    "note": "Not downloaded. Once the KiCad plug-in ingests this project, pin the * file kinds in mustCite to real sheet and board file names, tighten mustMention to the real reference designators and net names, and flip status to ready."
  },
  "plan": "engineer",
  "ownerEmail": "hynes-live@scope.local",
  "project": "antmicro/jetson-nano-baseboard",
  "turns": [
    { "ask": "Give me an overview of the schematic sheets in this baseboard.", "kind": "lookup",
      "mustMention": ["/sheet/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Which connector does the compute module plug into?", "kind": "lookup",
      "mustMention": ["/SO-?DIMM|260/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "How is the board powered — what comes in, and which rails are derived from it?", "kind": "lookup",
      "mustMention": ["/\\b5 ?V\\b/", "/3\\.3 ?V|3V3/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Which regulator generates the 3.3 V rail?", "kind": "followup",
      "mustMention": ["/regulator|buck|LDO|converter/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Review the decoupling on that regulator's input and output against typical datasheet recommendations.", "kind": "hard",
      "mustMention": ["/capacitor|decoupl/", "/µF|uF|nF/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Which nets connect to the module's power-enable and power-good pins?", "kind": "lookup",
      "mustMention": ["/net/", "/enable|power.good|\\bPG\\b/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Trace the Ethernet path from the module to the RJ45 jack.", "kind": "lookup",
      "mustMention": ["/RJ45|magnetics|MDI/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Are the magnetics integrated into that jack or a separate part?", "kind": "followup",
      "mustMention": ["/magnetics|integrated|transformer/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Which footprints are used for the USB connectors?", "kind": "lookup",
      "mustMention": ["/footprint/", "/USB/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*.kicad_pcb" }] },
    { "ask": "Where are the MIPI CSI camera connectors, and how many lanes does each carry?", "kind": "lookup",
      "mustMention": ["/CSI/", "/lane/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Compare the differential pair routing of the CSI lanes with the HDMI pairs on the PCB.", "kind": "hard",
      "mustMention": ["/differential|impedance/", "/length|skew|match/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*.kicad_pcb" }] },
    { "ask": "What layer stack does the PCB use?", "kind": "lookup",
      "mustMention": ["/layer/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*.kicad_pcb" }] },
    { "ask": "And which of those layers carry ground pours?", "kind": "followup",
      "mustMention": ["/GND|ground/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*.kicad_pcb" }] },
    { "ask": "List the nets on the 40-pin GPIO header.", "kind": "lookup",
      "mustMention": ["/header|GPIO/", "/I2C|UART|SPI/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Are any header pins left floating that should have pull-ups? Explain why.", "kind": "hard",
      "mustMention": ["/pull.?up/", "/I2C|SDA|SCL|floating/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Which reference designators are the bulk capacitors on the power input?", "kind": "lookup",
      "mustMention": ["/\\bC\\d+/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "What does the fan header connect to, and is the fan PWM controlled?", "kind": "lookup",
      "mustMention": ["/fan/", "/PWM/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Run an ERC-style check: which power inputs are driven by nothing, or by more than one output?", "kind": "hard",
      "mustMention": ["/power (pin|input|output|flag)|PWR_FLAG|ERC/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Would adding PWR_FLAG symbols silence those, and is that the right fix here?", "kind": "followup",
      "mustMention": ["PWR_FLAG"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Build me a BOM summary of the passives, grouped by value.", "kind": "lookup",
      "mustMention": ["/BOM|bill of materials/", "/resistor|capacitor/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "How many distinct capacitor values are there?", "kind": "followup",
      "mustMention": ["/capacitor/", "/\\d+/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Suggest which passives could be consolidated to cut unique BOM lines without changing behaviour.", "kind": "hard",
      "mustMention": ["/consolidat|reduce|same value|replace/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "What package size are most of the resistors — 0402 or 0603?", "kind": "lookup",
      "mustMention": ["/0402|0603/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*.kicad_pcb" }] },
    { "ask": "Where is the mounting hole pattern defined, and what is its spacing?", "kind": "lookup",
      "mustMention": ["/mounting hole/", "/mm/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*.kicad_pcb" }] },
    { "ask": "Evaluate whether the HDMI connector has ESD protection on its data lines.", "kind": "hard",
      "mustMention": ["/ESD|TVS/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Which net carries the module's reset, and what drives it?", "kind": "lookup",
      "mustMention": ["/reset/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "Is there a manual reset button on that net?", "kind": "followup",
      "mustMention": ["/button|switch/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }] },
    { "ask": "What is the board outline size?", "kind": "lookup",
      "mustMention": ["/mm/", "/outline|Edge.Cuts/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*.kicad_pcb" }] },
    { "ask": "Plan for adding a second Ethernet port — which nets, footprints and layers would it touch?", "kind": "hard",
      "mustMention": ["/Ethernet|RJ45/", "/footprint|layer/"],
      "mustCite": [{ "project": "antmicro/jetson-nano-baseboard", "path": "*sch" }, { "project": "antmicro/jetson-nano-baseboard", "path": "*.kicad_pcb" }] },
    { "ask": "Summarise the issues we found in this review.", "kind": "followup",
      "mustMention": ["/decoupl|ESD|pull.?up|ERC|PWR_FLAG/"],
      "mustCite": [] }
  ]
}

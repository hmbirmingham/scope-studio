{
  "id": "code-bridge-bot-polls-day",
  "plugin": "code",
  "plugins": ["github"],
  "status": "ready",
  "description": "A student contributor's day on the BRIDGE Discord bot: how polls are created and voted on, the rate limiters, the async bridge and database session, and the bugs found along the way.",
  "fixture": { "kind": "corpus", "source": "github", "repositories": ["onlyycliff/BRIDGE-Discord-Bot"] },
  "plan": "student",
  "ownerEmail": "hynes-live@scope.local",
  "project": "onlyycliff/BRIDGE-Discord-Bot",
  "turns": [
    { "ask": "How does the bot send a poll to Discord?", "kind": "lookup",
      "mustMention": ["send_poll", "PollView", "/embed/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/poll_orchestrator.py" }] },
    { "ask": "What happens if more than five options are passed in?", "kind": "followup",
      "mustMention": ["/\\b5\\b|five/", "/warn|400|limit/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/poll_orchestrator.py" }] },
    { "ask": "How does the create poll endpoint validate the options it is given?", "kind": "lookup",
      "mustMention": ["/at least 2|two/", "/unique|dict\\.fromkeys|duplicate/", "/100/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/routes/poll_create.py" }] },
    { "ask": "What does _sanitize_mentions do to the question text?", "kind": "lookup",
      "mustMention": ["/everyone|here/", "/zero.width|200b/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/routes/poll_create.py" }] },
    { "ask": "How is the rate limit on creating polls configured?", "kind": "lookup",
      "mustMention": ["window_seconds", "max_hits"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/routes/poll_create.py" }] },
    { "ask": "Why is the rate limit key the constant create_poll — doesn't that throttle every coach together?", "kind": "hard",
      "mustMention": ["create_poll", "/global|every|all coaches|shared|single key/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/routes/poll_create.py" }] },
    { "ask": "Refactor create_poll so the rate limit is per coach instead of global.", "kind": "hard",
      "mustMention": ["/current_user|coach/", "/allow|_check_rate_limit/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/routes/poll_create.py" }] },
    { "ask": "Now make it two polls per ten seconds instead of one per second.", "kind": "followup",
      "mustMention": ["/\\b10(\\.0)?\\b/", "/\\b2\\b/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/routes/poll_create.py" }] },
    { "ask": "What storage backends does RateLimiter support?", "kind": "lookup",
      "mustMention": ["DictBackend", "RedisBackend"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/rate_limiter.py" }] },
    { "ask": "Compare DictBackend and RedisBackend for a gunicorn deployment with several workers.", "kind": "hard",
      "mustMention": ["/worker|process/", "/redis/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/rate_limiter.py" }] },
    { "ask": "How long does RedisBackend keep a key around?", "kind": "followup",
      "mustMention": ["/3600|hour/", "/expire/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/rate_limiter.py" }] },
    { "ask": "Is RedisBackend.cleanup safe under concurrent requests, given it deletes the list and pushes it back?", "kind": "hard",
      "mustMention": ["/race|atomic|concurren/", "/delete/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/rate_limiter.py" }] },
    { "ask": "How is the login endpoint rate limited?", "kind": "lookup",
      "mustMention": ["/300/", "/\\b10\\b/", "/remote_addr|\\bip\\b/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/routes/auth.py" }] },
    { "ask": "And what does it return when the password is wrong?", "kind": "followup",
      "mustMention": ["/401/", "/invalid email or password/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/routes/auth.py" }] },
    { "ask": "What is CoachUser for?", "kind": "lookup",
      "mustMention": ["/flask.login|UserMixin/", "/adapter|model/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/auth.py" }] },
    { "ask": "How does PollState know a user already voted after the bot restarts?", "kind": "lookup",
      "mustMention": ["has_voted", "/database|\\bdb\\b/", "run_sync"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/poll_state.py" }] },
    { "ask": "Where is that run_sync defined and how does it work?", "kind": "followup",
      "mustMention": ["async_bridge", "run_coroutine_threadsafe", "/30/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/async_bridge.py" }] },
    { "ask": "Why use one background event loop instead of asyncio.run in every request?", "kind": "hard",
      "mustMention": ["/loop/", "/per request|create|destroy|each request/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/async_bridge.py" }] },
    { "ask": "Walk me through what happens when someone clicks a vote button.", "kind": "lookup",
      "mustMention": ["handle_vote", "is_active", "has_voted"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/poll_view.py" }] },
    { "ask": "Debug this: two fast clicks from the same user sometimes count twice. Where is the race?", "kind": "hard",
      "mustMention": ["has_voted", "/race|await|before|check/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/poll_view.py" }] },
    { "ask": "Does handle_vote ever call poll_state.record_vote directly?", "kind": "followup",
      "mustMention": ["record_vote", "/adapter/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/poll_view.py" }] },
    { "ask": "How is a poll's poll_id created?", "kind": "lookup",
      "mustMention": ["/time\\.time|millisecond|1000/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/poll_view.py" }] },
    { "ask": "What are the trade-offs of using a millisecond timestamp as that id?", "kind": "hard",
      "mustMention": ["/collision|collide|same millisecond|unique/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/poll_view.py" }] },
    { "ask": "Which tables does db/models.py define?", "kind": "lookup",
      "mustMention": ["forms", "responses", "coaches", "industry_tours"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "db/models.py" }] },
    { "ask": "How do the partial unique indexes on responses enforce one vote per user?", "kind": "lookup",
      "mustMention": ["uq_response_single_per_user", "uq_response_option_per_user"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "db/models.py" }] },
    { "ask": "Why is question_type denormalised onto the responses table?", "kind": "hard",
      "mustMention": ["/partial|index/", "/join/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "db/models.py" }] },
    { "ask": "How does db/session.py normalise the DATABASE_URL?", "kind": "lookup",
      "mustMention": ["asyncpg", "postgres://"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "db/session.py" }] },
    { "ask": "Review dispose_engine — does it actually reset the session factory?", "kind": "hard",
      "mustMention": ["/global/", "_async_session_factory"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "db/session.py" }] },
    { "ask": "Fix that bug in dispose_engine.", "kind": "hard",
      "mustMention": ["/global[^\\n]*_async_session_factory/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "db/session.py" }] },
    { "ask": "What does ensure_db do on Railway while Postgres is still starting?", "kind": "lookup",
      "mustMention": ["check_db", "/15/", "/sleep|retry|retries|every second/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "db/session.py" }] },
    { "ask": "Its docstring says it raises on timeout — does it really?", "kind": "followup",
      "mustMention": ["/not raise|doesn't raise|does not raise|never raises|returns without|silently/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "db/session.py" }] },
    { "ask": "How does end_poll_and_send_results find the channel to post results in?", "kind": "lookup",
      "mustMention": ["get_poll_metadata", "/resolve/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/poll_orchestrator.py" }] },
    { "ask": "What does ChannelCache.resolve do on a cache miss?", "kind": "followup",
      "mustMention": ["fetch_channel"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/channel_cache.py" }] },
    { "ask": "What is the BotAdapter seam, and what is StubBotAdapter there for?", "kind": "lookup",
      "mustMention": ["RealBotAdapter", "StubBotAdapter", "/test/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "CONTEXT.md" }] },
    { "ask": "Plan for moving PollState to Redis so it holds up across several workers — what changes first?", "kind": "hard",
      "mustMention": ["PollState", "/redis/", "/user_votes|active/"],
      "mustCite": [{ "project": "onlyycliff/BRIDGE-Discord-Bot", "path": "bridge_bot/poll_state.py" }] },
    { "ask": "Summarise the bugs we found today.", "kind": "followup",
      "mustMention": ["dispose_engine", "/race|twice|double/", "ensure_db"],
      "mustCite": [] }
  ]
}

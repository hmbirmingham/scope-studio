{
  "id": "code-imaging-colony-counter-day",
  "plugin": "code",
  "plugins": ["github"],
  "status": "ready",
  "description": "A day on the backlit plate imager: learn the counting pipeline, chase the dense_pack and high_touching recall failures through the watershed, change the peak spacing, then the LED driver, organism profiles and the validation path.",
  "fixture": { "kind": "corpus", "source": "github", "repositories": ["hmbirmingham/imaging-system"] },
  "plan": "engineer",
  "ownerEmail": "hynes-live@scope.local",
  "project": "hmbirmingham/imaging-system",
  "turns": [
    { "ask": "What does quantify_colonies return?", "kind": "lookup",
      "mustMention": ["count", "summary_stats", "px_per_mm"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "And what goes into summary_stats specifically?", "kind": "followup",
      "mustMention": ["mean_area_mm2", "coverage_pct", "hemolysis_candidates"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "How is the backlight illumination gradient removed before thresholding?", "kind": "lookup",
      "mustMention": ["GaussianBlur", "/subtract/", "/bg_blur_kernel|151/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "Why is the default blur kernel as large as 151?", "kind": "hard",
      "mustMention": ["/gradient|hotspot/", "/odd/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "How are colony areas converted from pixels to mm²?", "kind": "lookup",
      "mustMention": ["px_per_mm", "/PLATE_INNER_RADIUS_MM|inner radius/", "/\\b40\\b/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "Where does the server get the inner radius it passes in — is it the same 40 mm constant?", "kind": "followup",
      "mustMention": ["plate_inner_radius_mm", "/diameter/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "app_settings.py" }, { "project": "hmbirmingham/imaging-system", "path": "server.py" }] },
    { "ask": "Compare the touching_colony flag with what the watershed actually splits: when does a colony get flagged as touching?", "kind": "hard",
      "mustMention": ["touching_colony", "/blob|pre_watershed_labels/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "What is WATERSHED_MIN_PEAK_DISTANCE_PX set to, and what was that value chosen against?", "kind": "lookup",
      "mustMention": ["/\\b4\\b/", "/4\\.7|smallest/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "Which held-out sets fail the blind evaluation?", "kind": "lookup",
      "mustMention": ["dense_pack", "high_touching"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "testing/blind_eval/results/blind_eval_results.md" }] },
    { "ask": "What's the recall on those two sets?", "kind": "followup",
      "mustMention": ["/0\\.725/", "/0\\.645/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "testing/blind_eval/results/blind_eval_results.md" }] },
    { "ask": "Why would dense_pack and high_touching lose recall while precision stays at 1.000?", "kind": "hard",
      "mustMention": ["/merg|under-?segment|split/", "/watershed/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "testing/blind_eval/results/blind_eval_results.md" }, { "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "Explain why seeding watershed markers from local maxima splits touching colonies better than a single sure-foreground threshold.", "kind": "hard",
      "mustMention": ["/maxim/", "/saddle|threshold/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "What did that marker change do to the area of isolated colonies, and how was it handled?", "kind": "followup",
      "mustMention": ["/10 ?%/", "/full pre-watershed extent|expand/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "Refactor _apply_watershed so the minimum peak distance is a parameter passed down from quantify_colonies instead of a module constant.", "kind": "hard",
      "mustMention": ["_apply_watershed", "/WATERSHED_MIN_PEAK_DISTANCE_PX|peak_distance/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "Now default that new parameter to 3 instead of 4.", "kind": "followup",
      "mustMention": ["/\\b3\\b/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "Why did you keep the old module constant around in that refactor?", "kind": "followup",
      "mustMention": ["WATERSHED_MIN_PEAK_DISTANCE_PX"],
      "mustCite": [] },
    { "ask": "What anomaly flags can quantify.py add to a colony?", "kind": "lookup",
      "mustMention": ["unusual_size", "non_circular", "hemolysis_candidate"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "How does the haemolysis measurement around a colony work?", "kind": "lookup",
      "mustMention": ["/annul/", "/background|bg_mean/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "What's the difference between anomaly_flags and stat_flags?", "kind": "lookup",
      "mustMention": ["anomaly_flags", "stat_flags", "anomaly.py"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "anomaly.py" }] },
    { "ask": "How does the IQR check in StatisticalDetector work?", "kind": "lookup",
      "mustMention": ["/1\\.5/", "/q1|q3|percentile|quartile/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "anomaly.py" }] },
    { "ask": "When does the ML layer in anomaly.py actually switch on?", "kind": "lookup",
      "mustMention": ["/train/", "/anomaly\\.pkl|scikit|sklearn/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "anomaly.py" }] },
    { "ask": "How many labelled colonies does the diagnostics page want before it says ready to train?", "kind": "followup",
      "mustMention": ["/\\b50\\b/", "/min_labels|ready_to_train/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "ml_diagnostics.py" }] },
    { "ask": "Evaluate whether an isolation forest contamination of 0.05 makes sense for plates where nearly every colony is normal.", "kind": "hard",
      "mustMention": ["contamination", "/0\\.05|5 ?%/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "anomaly.py" }] },
    { "ask": "How is is_anomaly decided in AnomalyDetector.analyse?", "kind": "lookup",
      "mustMention": ["/stat_flags|statistical/", "/ml_anomaly|\\bML\\b/", "/either|\\bor\\b/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "anomaly.py" }] },
    { "ask": "What does apply_profile do for a swarming organism like Proteus mirabilis?", "kind": "lookup",
      "mustMention": ["/SWARM_SUPPRESSED_FLAGS|touching_colony/", "streak_or_artifact"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "profiles.py" }] },
    { "ask": "Is the Proteus mirabilis profile validated?", "kind": "followup",
      "mustMention": ["/validated/", "/false|\\bnot\\b/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "profiles/organisms/proteus_mirabilis.yaml" }] },
    { "ask": "So does it ever get the outside_expected_size flag then?", "kind": "followup",
      "mustMention": ["outside_expected_size", "/validated/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "profiles.py" }] },
    { "ask": "What mm² band does a medium colony with loose tolerance map to?", "kind": "lookup",
      "mustMention": ["/4\\.5/", "/\\b9(\\.0)?\\b/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "profiles.py" }] },
    { "ask": "Add a unit test that checks apply_profile drops touching_colony for a swarming profile.", "kind": "hard",
      "mustMention": ["/def test_/", "touching_colony"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "profiles.py" }] },
    { "ask": "How does the server set the LED brightness?", "kind": "lookup",
      "mustMention": ["api/led", "set_brightness"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "server.py" }, { "project": "hmbirmingham/imaging-system", "path": "led_pwm.py" }] },
    { "ask": "Which GPIO pin and PWM switching frequency does led_pwm.c use?", "kind": "lookup",
      "mustMention": ["/\\b12\\b/", "/25 ?kHz/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "led_pwm.c" }] },
    { "ask": "How is that switching frequency derived?", "kind": "followup",
      "mustMention": ["/25 ?MHz/", "/1000/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "led_pwm.c" }] },
    { "ask": "Why is the compiled library named led_pwm_native.so rather than led_pwm.so?", "kind": "hard",
      "mustMention": ["/shadow/", "/import/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "led_pwm.py" }] },
    { "ask": "The header comment in led_pwm.c still says gcc -o led_pwm.so — is that stale?", "kind": "followup",
      "mustMention": ["led_pwm_native.so", "/stale|out of date|outdated|mismatch|inconsistent/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "led_pwm.c" }, { "project": "hmbirmingham/imaging-system", "path": "led_pwm.py" }] },
    { "ask": "Fix the comment in led_pwm.c so its build command matches what led_pwm.py actually runs.", "kind": "hard",
      "mustMention": ["led_pwm_native.so"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "led_pwm.c" }] },
    { "ask": "What happens to the LED when the Python process exits?", "kind": "lookup",
      "mustMention": ["pwm_cleanup", "/__del__|garbage/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "led_pwm.py" }] },
    { "ask": "Which columns in the training CSV record validation?", "kind": "lookup",
      "mustMention": ["validation_status", "validated_by"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "data_logger.py" }] },
    { "ask": "How does counting_accuracy compute detection precision and recall?", "kind": "lookup",
      "mustMention": ["false_positive", "/added|missed/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "ml_diagnostics.py" }] },
    { "ask": "Review the /api/validate handler for anything that could corrupt the training CSV.", "kind": "hard",
      "mustMention": ["apply_validation", "/csv/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "server.py" }] },
    { "ask": "Earlier you said touching_colony comes from the pre-watershed blobs — does apply_profile ever remove it?", "kind": "followup",
      "mustMention": ["/swarm/", "touching_colony"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "profiles.py" }] },
    { "ask": "Plan for raising dense_pack recall above 0.90 without hurting irregular_morphology — what would you change first?", "kind": "hard",
      "mustMention": ["dense_pack", "/watershed|peak/"],
      "mustCite": [{ "project": "hmbirmingham/imaging-system", "path": "testing/blind_eval/results/blind_eval_results.md" }, { "project": "hmbirmingham/imaging-system", "path": "quantify.py" }] },
    { "ask": "Summarise what we changed today and what is still open.", "kind": "followup",
      "mustMention": ["/peak|watershed/", "led_pwm"],
      "mustCite": [] }
  ]
}

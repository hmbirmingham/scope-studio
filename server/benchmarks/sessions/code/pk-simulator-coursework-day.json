{
  "id": "code-pk-simulator-coursework-day",
  "plugin": "code",
  "plugins": ["github"],
  "status": "ready",
  "description": "A student's coursework day on the two-compartment PK simulator: the ODE and solver, dosing routes, the analysis helpers and their bugs, and the vancomycin validation.",
  "fixture": { "kind": "corpus", "source": "github", "repositories": ["hmbirmingham/Pharmacokinetic-Simulator"] },
  "plan": "student",
  "ownerEmail": "hynes-live@scope.local",
  "project": "hmbirmingham/Pharmacokinetic-Simulator",
  "turns": [
    { "ask": "What ODE system does the simulator solve?", "kind": "lookup",
      "mustMention": ["k10", "k12", "k21", "V1"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "pk_model.py" }] },
    { "ask": "Which solver and tolerances does solve_2cmt use?", "kind": "lookup",
      "mustMention": ["RK45", "/1e-8/", "/1e-10/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "pk_model.py" }] },
    { "ask": "Why RK45 rather than an implicit method?", "kind": "hard",
      "mustMention": ["/stiff/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "pk_model.py" }] },
    { "ask": "How is an IV bolus modelled?", "kind": "lookup",
      "mustMention": ["/0\\.0167|1.minute|one.minute/", "/infusion/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "dosing.py" }] },
    { "ask": "Could the adaptive RK45 step skip over that one-minute bolus window entirely? Explain why or why not.", "kind": "hard",
      "mustMention": ["/max_step|step size|skip|step over/", "/0\\.0167|one.minute|1.minute/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "dosing.py" }, { "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "pk_model.py" }] },
    { "ask": "Fix solve_2cmt so a short bolus can't be stepped over.", "kind": "hard",
      "mustMention": ["max_step"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "pk_model.py" }] },
    { "ask": "Now make that max_step an optional argument that defaults to the bolus duration.", "kind": "followup",
      "mustMention": ["max_step", "/0\\.0167|bolus_duration/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "pk_model.py" }] },
    { "ask": "How does oral dosing work in dosing.py?", "kind": "lookup",
      "mustMention": ["/\\bka\\b/", "/bioavailab|\\bF\\b/", "/exp/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "dosing.py" }] },
    { "ask": "How does multi_dose combine several doses?", "kind": "lookup",
      "mustMention": ["/superpos|sum/", "/linear/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "dosing.py" }] },
    { "ask": "Why does the shifted function bind _fn and _t0 as default arguments?", "kind": "hard",
      "mustMention": ["/late binding|closure|loop variable|captur/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "dosing.py" }] },
    { "ask": "What does regular_dosing(6, 8) return?", "kind": "lookup",
      "mustMention": ["/0, ?8, ?16, ?24, ?32, ?40/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "dosing.py" }] },
    { "ask": "How is AUC computed?", "kind": "lookup",
      "mustMention": ["/trapez|trapz/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "analysis.py" }] },
    { "ask": "np.trapz is deprecated in NumPy 2 — migrate auc_trapz to its replacement.", "kind": "hard",
      "mustMention": ["trapezoid"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "analysis.py" }] },
    { "ask": "How does auc_extrap_inf extrapolate to infinity?", "kind": "lookup",
      "mustMention": ["lambda_z", "/C_last|last/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "analysis.py" }] },
    { "ask": "What does terminal_half_life in analysis.py return?", "kind": "lookup",
      "mustMention": ["/tuple|R²|r2|r\\^2|r squared/", "/nan/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "analysis.py" }] },
    { "ask": "Review terminal_half_life and pk_summary together — is the nan check in pk_summary right?", "kind": "hard",
      "mustMention": ["/is not np\\.nan|isnan|identity/", "/tuple/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "analysis.py" }] },
    { "ask": "Rewrite that check so it handles both return types properly.", "kind": "hard",
      "mustMention": ["isinstance", "/nan/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "analysis.py" }] },
    { "ask": "What does the accumulation index tell me?", "kind": "lookup",
      "mustMention": ["/accumulat/", "/exp|interval|tau/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "analysis.py" }] },
    { "ask": "How are alpha and beta computed in pk_model.py?", "kind": "lookup",
      "mustMention": ["/sqrt|square root/", "/k10 ?\\* ?k21/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "pk_model.py" }] },
    { "ask": "What's the formula for Vss here?", "kind": "followup",
      "mustMention": ["V1", "/k12 ?\\/ ?k21/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "pk_model.py" }] },
    { "ask": "What vancomycin results does the README report?", "kind": "lookup",
      "mustMention": ["/2\\.78/", "/90\\.7/", "/elevated/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "README.md" }] },
    { "ask": "Why is the computed terminal half-life around 27 hours when the reference is 6 to 8?", "kind": "hard",
      "mustMention": ["/renal/", "Matzke"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "README.md" }] },
    { "ask": "Which paper are those reference parameters from?", "kind": "followup",
      "mustMention": ["Matzke", "1984"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "README.md" }] },
    { "ask": "What AUC/MIC target do the 2020 vancomycin guidelines recommend?", "kind": "lookup",
      "mustMention": ["/400/", "/600/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "README.md" }] },
    { "ask": "Implement a function that computes the 24-hour AUC at steady state for a q12h regimen using the existing helpers.", "kind": "hard",
      "mustMention": ["auc_trapz", "/24/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "analysis.py" }, { "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "dosing.py" }] },
    { "ask": "Now divide it by an MIC argument and flag whether the ratio is inside 400 to 600.", "kind": "followup",
      "mustMention": ["/mic/", "/400/", "/600/"],
      "mustCite": [] },
    { "ask": "What does ctrough return for a q12h regimen?", "kind": "lookup",
      "mustMention": ["/min/", "/last/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "analysis.py" }] },
    { "ask": "Evaluate whether steady_state_avg over just the last interval is enough after six doses with a 27 hour half-life.", "kind": "hard",
      "mustMention": ["/half.li|t½/", "/steady.state/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "analysis.py" }] },
    { "ask": "Which plots does visualization.py produce?", "kind": "lookup",
      "mustMention": ["/4.panel|four.panel|spider|sensitivity/"],
      "mustCite": [{ "project": "hmbirmingham/Pharmacokinetic-Simulator", "path": "visualization.py" }] },
    { "ask": "Summarise the fixes we made today.", "kind": "followup",
      "mustMention": ["max_step", "trapezoid", "isinstance"],
      "mustCite": [] }
  ]
}
